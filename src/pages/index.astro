---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';

// 拿到所有周记，过滤掉草稿，按日期倒序
const all = await getCollection('entries', ({ data }) => !data.draft);
all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
  <section class="wrap intro">
    <h1>Topic Reflection</h1>
    <p>
      A running record of my semester, step by step — from Post-it brainstorms to
      sketchbook pages to rough prototypes, alongside my weekly reading reflections.
      Documenting the process is how I review, reflect, save ideas, and share the way
      my thinking evolves.
    </p>
  </section>

  <section class="wrap timeline">
    {all.length === 0 && (
      <p class="empty">
        Nothing here yet. Add a <code>.md</code> file to <code>src/content/entries/</code> and it will show up here.
      </p>
    )}
    {all.map((entry) => (
      <EntryCard
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}entries/${entry.id}`}
        title={entry.data.title}
        date={entry.data.date}
        week={entry.data.week}
        summary={entry.data.summary}
        tags={entry.data.tags}
        cover={entry.data.cover}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: 56px;
    padding-bottom: 8px;
  }
  .intro h1 {
    font-family: var(--font-serif);
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .intro p {
    color: var(--muted);
    font-size: 18px;
    max-width: 60ch;
    margin: 0;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 40px;
  }
  .empty {
    color: var(--muted);
    padding: 40px 0;
  }
</style>
