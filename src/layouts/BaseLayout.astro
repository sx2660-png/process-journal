---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
// 站点信息 —— 换成你自己的
const siteName = 'Process Journal';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description ?? 'A semester-long archive documenting my creative and design process.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{siteName}</a>
        <nav class="site-nav">
          <a href="/">Journal</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        © {new Date().getFullYear()} {siteName} · Documenting the process.
      </div>
    </footer>
  </body>
</html>
