---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';

interface Props {
  href: string;
  title: string;
  date: Date;
  week?: number;
  summary?: string;
  tags: string[];
  cover?: any;
}
const { href, title, date, week, summary, tags, cover } = Astro.props;
const remoteCover = typeof cover === 'string';
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<article class="card">
  {cover && (
    <a href={href} class="card__cover">
      {remoteCover
        ? <img src={cover} alt={title} loading="lazy" />
        : <Image src={cover} alt={title} width={820} height={430} />}
    </a>
  )}
  <div class="card__body">
    <div class="card__meta">
      {week != null && <span class="card__week">Week {week}</span>}
      <time datetime={date.toISOString()}>{dateStr}</time>
    </div>
    <h2 class="card__title"><a href={href}>{title}</a></h2>
    {summary && <p class="card__summary">{summary}</p>}
    {tags.length > 0 && (
      <div class="card__tags">
        {tags.map((t) => <Tag label={t} />)}
      </div>
    )}
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(35, 32, 27, 0.06), 0 14px 34px rgba(35, 32, 27, 0.1);
  }
  .card__cover {
    display: block;
    aspect-ratio: 820 / 430;
    overflow: hidden;
  }
  .card__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card__body { padding: 20px 24px 24px; }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .card__week {
    color: var(--accent);
    font-weight: 600;
  }
  .card__title {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.25;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .card__title a { color: var(--text); }
  .card__title a:hover { color: var(--accent); text-decoration: none; }
  .card__summary {
    margin: 0 0 14px;
    color: var(--muted);
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
